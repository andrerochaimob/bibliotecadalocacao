# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" NUNCA deve ser commitado no Git — ele fica de fora via .gitignore
# e precisa ser enviado manualmente pelo Gerenciador de Arquivos do hPanel
# (Hostinger) direto na raiz do site, fora do repositório.

# Supabase — projeto "bibliotecadalocacao"
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Chave "service_role" (secreta). NUNCA a chave "anon"/"publishable" aqui.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — envio de e-mail transacional
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responder@bibliotecadalocacao.com.br
RESEND_FROM_NAME=Biblioteca da Locação

# Segredo próprio, só deste site, usado para assinar o token anti-spam do
# formulário (independente das chaves do Supabase/Resend). Gere um valor
# aleatório longo, por exemplo com: php -r "echo bin2hex(random_bytes(32));"
APP_TOKEN_SECRET=
